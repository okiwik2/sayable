{
  "name": "sayable",
  "private": true,
  "version": "1.0.2",
  "description": "An offline-first AAC (augmentative and alternative communication) app with English and Mandarin, ARASAAC symbols and NZSL sign resources.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/build-lite.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "data": "node scripts/build-vocab.mjs",
    "data:validate": "node scripts/validate-vocab.mjs",
    "assets:symbols": "node scripts/fetch-arasaac.mjs",
    "assets:nzsl": "node scripts/fetch-nzsl.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:native": "npm run data && tsc --noEmit && vite build --mode native && cap sync",
    "android": "npm run build:native && cap open android",
    "ios": "npm run build:native && cap open ios",
    "assets:videos": "node scripts/fetch-sign-videos.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --assetPath resources --android --ios",
    "assets:nzsl-urls": "node scripts/update-nzsl-urls.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "dexie": "4.2.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-legacy": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "acorn": "8.19.0",
    "fake-indexeddb": "6.0.1",
    "jsdom": "26.1.0",
    "opencc-js": "1.0.5",
    "pinyin-pro": "3.27.0",
    "sharp": "0.34.5",
    "terser": "5.36.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
